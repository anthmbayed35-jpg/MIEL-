{
  "name": "miel-plus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/clean-data-cache.mjs && next build && node scripts/prepare-standalone.mjs",
    "start": "node scripts/start.mjs",
    "icons": "node scripts/make-icons.mjs",
    "images": "node scripts/make-images.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "create-owner": "tsx scripts/create-owner.ts",
    "purge-demo": "tsx --conditions=react-server scripts/purge-demo.ts",
    "seed-demo": "tsx --conditions=react-server scripts/seed-demo.ts",
    "check-env": "tsx scripts/check-env.ts",
    "verify": "npm run typecheck && npm run lint && npm run test:unit && npm run test:integration && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1172.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "archiver": "^8.0.0",
    "argon2": "^0.45.2",
    "better-sqlite3": "^13.2.0",
    "next": "^16.4.6",
    "nodemailer": "^10.6.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22"
  }
}
