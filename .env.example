# MIEL+ environment variables (names only. Real values go in the Railway service Variables and a git-ignored .env.local).
# ALL of them must exist at BUILD time on Railway. Full explanation, Railway steps and backups: docs/OPERATIONS.md

# Which environment is this?  production | staging | development
MIEL_ENV=development

# The FINAL public URL (https, no trailing slash in production). The ONLY source of absolute URLs (sitemap, robots,
# Open Graph, invite and reset links). Baked in at build time: redeploy after changing it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SQLite database file. Production: the file on the Railway volume mounted at /data. Local: any absolute path.
DATABASE_PATH=/data/miel.db

# SECRET, 32+ random characters. Encrypts two-factor secrets, salts hashes. Never commit.
AUTH_SECRET=

# Public storefront: live (default) or maintenance (503 "MIEL+ is under development" page; no order can be placed;
# admin, sign-in, /api/health and uploads stay open). Read at runtime: change it and restart, no rebuild.
SITE_MODE=live

# Email (invites, password resets, order alerts). OPTIONAL until configured: without it the admin shows a banner and
# hands the owner copyable one-time links instead of emailing them. Nothing fails.
MAIL_FROM="MIEL+ <orders@your-domain.com>"
BREVO_API_KEY=
# Alternative to Brevo:
# MAIL_PROVIDER=smtp
# SMTP_URL=smtp://user:password@host:587

# Optional
# STORE_TIMEZONE=Asia/Beirut
# Off-site encrypted backups (S3-compatible: AWS, Cloudflare R2, Backblaze B2)
# BACKUP_S3_BUCKET=
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_REGION=
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_PREFIX=miel/
# BACKUP_ENCRYPTION_KEY=
# BACKUPS_DISABLED=1
# MIGRATIONS_DIR=
# SKIP_ENV_CHECK=1
# Optional: shows the "Pin your location" step at checkout. Enable Maps JavaScript API and Places API (New), restrict the key by HTTP referrer.
# GOOGLE_MAPS_API_KEY=

# Set by Railway, do not set: PORT, RAILWAY_ENVIRONMENT_NAME
