# MIEL+ environment variables (names only. Real values go in the Railway service Variables and a git-ignored .env.local. ALL of them must exist at BUILD time on Railway).
# Full explanation, per-environment values and setup steps: docs/OPERATIONS.md

# Which environment is this?  production | staging | development
MIEL_ENV=development

# The PRODUCTION Supabase project URL. Set it in EVERY environment so non-production ones can refuse to use it.
MIEL_PRODUCTION_SUPABASE_URL=https://your-production-project.supabase.co

# This environment's database. Production: the production project. Preview/local: a SEPARATE staging project.
NEXT_PUBLIC_SUPABASE_URL=https://your-staging-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET. Server only. Never prefix with NEXT_PUBLIC_, never import in client code, never commit.
SUPABASE_SERVICE_ROLE_KEY=

# The FINAL public URL of this environment (https, no trailing slash in production). The ONLY source of absolute URLs
# (sitemap, robots, Open Graph, JSON-LD, invite/reset email links). Baked in at build time: redeploy after changing it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set by Railway, do not set: PORT, RAILWAY_ENVIRONMENT_NAME

# Optional
# STORE_TIMEZONE=Asia/Beirut
# RESEND_API_KEY=
# NOTIFY_FROM="MIEL+ <orders@your-domain.com>"
